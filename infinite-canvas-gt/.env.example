# ── Infinite-Canvas-GT 无头服务配置（复制为 API/.env 或导出为环境变量）──

# 监听地址：同机部署保持 127.0.0.1；局域网/远程用需同时设 APP_TOKEN。
HOST=127.0.0.1
PORT=3000

# 远程访问鉴权令牌。
#   留空 = 只允许本机回环访问（matrix-loop 同机调用免 token）。
#   局域网/远程调用时设一个长随机串，调用方带 header: X-App-Token: <值>
APP_TOKEN=

# CORS 允许来源。留空=仅本机；"*"=全放行(不建议)；逗号分隔可写多个。
CORS_ORIGINS=

# 无头模式；关闭 GitHub 自更新端点（服务化强烈建议 0）。
HEADLESS=1
ENABLE_SELF_UPDATE=0

# ── 作业执行器 ──
JOB_CONCURRENCY=3
JOB_MAX_RETRIES=2
JOB_POLL_INTERVAL_MS=2000
JOB_TIMEOUT_SEC=1800
# JOBS_DB_PATH=data/jobs.db
# JOBS_SELF_BASE_URL=http://127.0.0.1:3000

# ── 各引擎凭证（按需填）──
MODELSCOPE_API_KEY=
COMFLY_API_KEY=
COMFLY_BASE_URL=https://ai.comfly.chat
# 即梦：需先用 dreamina CLI 登录（UI 里扫码或 /api/jimeng/login/start）
# RunningHub / 火山：在 UI 左下角「API 设置」里配置
