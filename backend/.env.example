# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# LLM relay: newapi (Anthropic-compatible /v1/messages) — used as fallback
MATRIXLOOP_ANTHROPIC_API_KEY=sk-your-newapi-key
MATRIXLOOP_ANTHROPIC_BASE_URL=https://newapi.example.com
MATRIXLOOP_LLM_MODEL=claude-sonnet-4-6

# AgensAI (免费每日额度):优先用,配额用完自动回退到上面的 newapi
MATRIXLOOP_AGENS_API_KEY=sk-your-agens-key
MATRIXLOOP_AGENS_BASE_URL=https://api.agens.example/v1
MATRIXLOOP_AGENS_PROTOCOL=openai            # openai (/chat/completions) | anthropic (/v1/messages)
MATRIXLOOP_AGENS_MODEL=                      # 留空则用 LLM_MODEL
MATRIXLOOP_PREFER_AGENS=true

# --- faceless 口播成片 ---
# 全局默认 provider(X/IG 等非 Aurea 账号)。Aurea 账号由 avatar_handles 路由到 avatar。
MATRIXLOOP_VIDEO_PROVIDER=waoowaoo_narrated
MATRIXLOOP_FACELESS_VISUAL=fake
# 装配层:ffmpeg(默认)或 remotion
MATRIXLOOP_FACELESS_COMPOSITOR=ffmpeg

# --- Aurea 数字人管线 ---
MATRIXLOOP_AVATAR_HANDLES=askaurea
MATRIXLOOP_IMAGE_PROVIDER=newapi
MATRIXLOOP_IMAGE_MODEL=nano-banana-pro-preview
MATRIXLOOP_TTS_PROVIDER=edge
MATRIXLOOP_TTS_VOICE=zh-TW-HsiaoChenNeural
# 手动测试期间关掉自启,避免后台定时烧额度;实机验证 OK 后再设 true
MATRIXLOOP_SCHEDULER_AUTOSTART=false

# --- RunningHub (img2video) — 可选 ---
MATRIXLOOP_RUNNINGHUB_API_KEY=
MATRIXLOOP_RUNNINGHUB_BASE_URL=https://www.runninghub.cn

# --- waoowaoo b-roll 集成 ---
MATRIXLOOP_WAOOWAOO_BASE_URL=http://127.0.0.1:13000
MATRIXLOOP_WAOOWAOO_INTERNAL_TOKEN=your-waoowaoo-internal-task-token
MATRIXLOOP_WAOOWAOO_USER_ID=your-waoowaoo-service-user-id
# 生图 + i2v 走 SiliconFlow
MATRIXLOOP_WAOOWAOO_SF_API_KEY=sk-your-siliconflow-key
MATRIXLOOP_WAOOWAOO_SF_VIDEO_MODEL=Wan-AI/Wan2.2-I2V-A14B
MATRIXLOOP_WAOOWAOO_PANELS=5
MATRIXLOOP_WAOOWAOO_LOCALE=en

# --- 每日配额 ---
MATRIXLOOP_VIDEO_PER_ACCOUNT_PER_DAY=20
MATRIXLOOP_VIDEO_MAX_PER_DAY=40

# --- 平台流量数据(可留空,留空则粉丝数为空)---
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
INSTAGRAM_TOKEN=
INSTAGRAM_BUSINESS_ID=
SCRAPECREATORS_API_KEY=
